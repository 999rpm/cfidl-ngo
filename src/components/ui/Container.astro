---
interface Props {
  class?: string;
  size?: 'default' | 'narrow' | 'wide';
  as?: 'div' | 'section';
}

const { class: className = '', size = 'default', as: Tag = 'div' } = Astro.props as Props;

const widths: Record<NonNullable<Props['size']>, string> = {
  narrow: 'max-w-3xl',
  default: 'max-w-6xl',
  wide: 'max-w-7xl',
};
---

<Tag class:list={['mx-auto w-full px-6 sm:px-8 lg:px-10', widths[size], className]}>
  <slot />
</Tag>
