---
interface Props {
  class?: string;
}
const { class: className = 'h-9 w-9' } = Astro.props;
---

{
  /* Abstract mark: a marigold bloom — six petals radiating from a shared
     centre, echoing both the marigold garlands used across Bangladeshi
     celebrations and the "collective" in CFIDL's name. Original placeholder
     mark; swap for a real logo via Site Settings in Studio. */
}
<svg
  class={className}
  viewBox="0 0 40 40"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <circle cx="20" cy="20" r="20" fill="currentColor" class="text-saffron"></circle>
  <g fill="var(--color-marigold)">
    <ellipse cx="20" cy="10.5" rx="4" ry="7.2"></ellipse>
    <ellipse cx="20" cy="10.5" rx="4" ry="7.2" transform="rotate(60 20 20)"></ellipse>
    <ellipse cx="20" cy="10.5" rx="4" ry="7.2" transform="rotate(120 20 20)"></ellipse>
    <ellipse cx="20" cy="10.5" rx="4" ry="7.2" transform="rotate(180 20 20)"></ellipse>
    <ellipse cx="20" cy="10.5" rx="4" ry="7.2" transform="rotate(240 20 20)"></ellipse>
    <ellipse cx="20" cy="10.5" rx="4" ry="7.2" transform="rotate(300 20 20)"></ellipse>
  </g>
  <circle cx="20" cy="20" r="5.2" fill="var(--color-mist)"></circle>
</svg>
