---
type Props = {
  name: IconName;
  class?: string;
  strokeWidth?: number;
};

export type IconName =
  | 'menu'
  | 'close'
  | 'chevron-down'
  | 'arrow-right'
  | 'arrow-up-right'
  | 'mail'
  | 'phone'
  | 'map-pin'
  | 'facebook'
  | 'linkedin'
  | 'x'
  | 'youtube'
  | 'instagram'
  | 'community'
  | 'business'
  | 'financier'
  | 'government'
  | 'collected'
  | 'treated'
  | 'soil'
  | 'reinvested'
  | 'play'
  | 'calendar'
  | 'download'
  | 'check'
  | 'info'
  | 'image';

const { name, class: className = '', strokeWidth = 1.75 } = Astro.props as Props;

// Hand-drawn, single-weight line icons (24x24) so the whole set shares one
// visual language without pulling in an icon package.
const paths: Record<IconName, string> = {
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6L6 18"/>',
  'chevron-down': '<path d="M6 9l6 6 6-6"/>',
  'arrow-right': '<path d="M5 12h14M13 6l6 6-6 6"/>',
  'arrow-up-right': '<path d="M7 17L17 7M8 7h9v9"/>',
  mail: '<path d="M4 6h16v12H4z"/><path d="M4 7l8 6 8-6"/>',
  phone:
    '<path d="M7 4h3l1.5 4-2 1.5a12 12 0 0 0 5 5l1.5-2 4 1.5v3a2 2 0 0 1-2.2 2A17 17 0 0 1 5 7.2 2 2 0 0 1 7 4z"/>',
  'map-pin':
    '<path d="M12 21s7-6.2 7-11.5a7 7 0 1 0-14 0C5 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.3"/>',
  facebook:
    '<path d="M15 8.5h2V5h-2.3C12.4 5 11 6.4 11 8.7V11H9v3h2v6h3v-6h2.3l.4-3H14v-1.8c0-.5.3-.7.6-.7z"/>',
  linkedin:
    '<rect x="4" y="9" width="3" height="10"/><circle cx="5.5" cy="5.5" r="1.6"/><path d="M11 19v-6.2c0-1.7 1-2.8 2.5-2.8s2.5 1.1 2.5 2.8V19M11 9.8h3"/>',
  x: '<path d="M5 5l14 14M19 5L5 19"/>',
  youtube:
    '<rect x="3.5" y="6.5" width="17" height="11" rx="3"/><path d="M10.5 9.7l5 2.3-5 2.3z" fill="currentColor" stroke="none"/>',
  instagram:
    '<rect x="4" y="4" width="16" height="16" rx="4.5"/><circle cx="12" cy="12" r="3.5"/><circle cx="16.6" cy="7.4" r="0.9" fill="currentColor" stroke="none"/>',
  community:
    '<circle cx="9" cy="8" r="2.5"/><path d="M4 19v-1.5A4 4 0 0 1 8 13.5h2a4 4 0 0 1 4 4V19"/><circle cx="17" cy="9" r="2"/><path d="M15.5 13.2A3.7 3.7 0 0 1 20 16.7V19"/>',
  business: '<path d="M7 21l6-6M10.5 9.5l4 4L20 8 16 4l-5.5 5.5z"/><path d="M4 21l3.3-1L4 16.7z"/>',
  financier: '<circle cx="9" cy="9" r="4.5"/><circle cx="15" cy="15" r="4.5"/><path d="M9 9l6 6"/>',
  government: '<path d="M4 10h16M5 10v9M19 10v9M9 10v9M15 10v9M3 19h18M12 3l8 4H4z"/>',
  collected:
    '<path d="M3 8h9v8H3zM12 11h4l3 3v2h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="16.5" cy="18" r="1.6"/>',
  treated:
    '<path d="M7 4l1.5 3H14L15.5 4M6 9a6 6 0 0 0 10.8 3.6M18 15l-1.5-3H11l-1.5 3"/><path d="M18 10a6 6 0 0 0-10.8-3.6"/>',
  soil: '<path d="M12 20v-7"/><path d="M12 13c0-3 2-4 4-4-0 3-1.5 4.5-4 4z"/><path d="M12 15c0-2.5-1.7-3.6-3.5-3.6.2 2.6 1.6 3.9 3.5 3.6z"/><path d="M4 20h16"/>',
  reinvested:
    '<path d="M4 15v3a2 2 0 0 0 2 2h3M20 9V6a2 2 0 0 0-2-2h-3M9 4H6a2 2 0 0 0-2 2v3M15 20h3a2 2 0 0 0 2-2v-3"/><circle cx="12" cy="12" r="3"/>',
  play: '<circle cx="12" cy="12" r="9"/><path d="M10 8.5l6 3.5-6 3.5z" fill="currentColor" stroke="none"/>',
  calendar: '<rect x="4" y="5.5" width="16" height="14" rx="2"/><path d="M4 10h16M8 3v4M16 3v4"/>',
  download:
    '<path d="M12 4v11m0 0l4-4m-4 4l-4-4"/><path d="M5 17v2a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-2"/>',
  check: '<path d="M5 13l4 4 10-10"/>',
  // Added to replace the last three uses of the "sparkle" icon (see
  // SESSION_LOG.md, Round 3) — a plain info-circle for the contact form's
  // config notice, and a picture frame for a missing-image placeholder.
  info: '<circle cx="12" cy="12" r="9"/><path d="M12 11v5"/><circle cx="12" cy="7.8" r="0.9" fill="currentColor" stroke="none"/>',
  image:
    '<rect x="4" y="5" width="16" height="14" rx="2"/><circle cx="9" cy="10" r="1.5"/><path d="M4.5 16.5l4.5-4 4 3.2 3-2.7 4 3.5"/>',
};
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths[name]}
/>
