---
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import type { Stat } from '../../lib/sanity/queries';

interface Props {
  eyebrow?: string;
  heading: string;
  headlineStats: Stat[];
  secondaryStats?: Stat[];
}
const { eyebrow, heading, headlineStats, secondaryStats = [] } = Astro.props;
---

<section class="bg-deep py-24 text-white sm:py-32">
  <Container>
    <SectionHeading eyebrow={eyebrow} heading={heading} onDark align="left" />

    <div data-animate-group class="mt-16 grid gap-x-8 gap-y-14 sm:grid-cols-3">
      {
        headlineStats.map((stat) => (
          <div data-animate-item class="relative border-t border-white/15 pt-6">
            <p class="stat-figure font-display text-5xl font-semibold tracking-tight text-white sm:text-[3.5rem]">
              <span
                data-counter
                data-counter-to={stat.value}
                data-counter-prefix={stat.prefix}
                data-counter-suffix={stat.suffix}
              >
                0
              </span>
            </p>
            <p class="mt-3 max-w-[26ch] font-mono text-[0.8rem] leading-snug text-white/60">
              {stat.label}
            </p>
          </div>
        ))
      }
    </div>

    {
      secondaryStats.length > 0 && (
        <div
          data-animate-group
          class="mt-16 grid gap-6 border-t border-white/10 pt-10 sm:grid-cols-3"
        >
          {secondaryStats.map((stat) => (
            <div data-animate-item class="flex items-baseline gap-3">
              <span class="stat-figure font-display text-marigold-light text-2xl font-semibold">
                <span
                  data-counter
                  data-counter-to={stat.value}
                  data-counter-prefix={stat.prefix}
                  data-counter-suffix={stat.suffix}
                >
                  0
                </span>
              </span>
              <span class="text-sm text-white/60">{stat.label}</span>
            </div>
          ))}
        </div>
      )
    }
  </Container>
</section>
