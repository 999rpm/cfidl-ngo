---
import Icon from '../ui/Icon.astro';

interface Props {
  subjects?: string[];
}
const {
  subjects = [
    'General enquiry',
    'Partnership / funding',
    'Press / media',
    'Careers',
    'Something else',
  ],
} = Astro.props;

const formId = import.meta.env.PUBLIC_FORMSPREE_FORM_ID;
const isConfigured = Boolean(formId);
---

<div data-contact-form data-form-id={formId}>
  {
    !isConfigured && (
      <div class="border-marigold/30 bg-marigold/10 text-ink/80 mb-6 flex items-start gap-3 rounded-xl border p-4 text-sm">
        <Icon name="sparkle" class="text-marigold mt-0.5 h-4 w-4 shrink-0" />
        <p>
          This form isn't connected yet — add{' '}
          <code class="bg-ink/5 rounded px-1.5 py-0.5 font-mono text-xs">
            PUBLIC_FORMSPREE_FORM_ID
          </code>{' '}
          to your <code class="bg-ink/5 rounded px-1.5 py-0.5 font-mono text-xs">.env</code> file.
          See the README for setup steps.
        </p>
      </div>
    )
  }

  <div
    data-fs-success
    class="border-paddy/30 bg-paddy/10 text-paddy mb-6 items-start gap-3 rounded-xl border p-4 text-sm"
  >
    <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0" />
    <p>Thanks — your message is on its way. We'll get back to you soon.</p>
  </div>
  <div
    data-fs-error=""
    class="border-brick/30 bg-brick/10 text-brick mb-6 items-start gap-3 rounded-xl border p-4 text-sm"
  >
    <Icon name="close" class="mt-0.5 h-4 w-4 shrink-0" />
    <p>Something went wrong sending your message — please try again, or email us directly.</p>
  </div>

  <form id="contact-form" class="grid gap-5 sm:grid-cols-2">
    <div class="sm:col-span-1">
      <label for="name" class="text-ink mb-1.5 block text-sm font-medium">Name</label>
      <input
        id="name"
        name="name"
        type="text"
        required
        data-fs-field
        class="border-ink/15 focus:border-saffron w-full rounded-xl border bg-white px-4 py-3 text-sm transition-colors outline-none"
      />
      <span data-fs-error="name" class="text-brick mt-1 block text-xs"></span>
    </div>

    <div class="sm:col-span-1">
      <label for="email" class="text-ink mb-1.5 block text-sm font-medium">Email</label>
      <input
        id="email"
        name="email"
        type="email"
        required
        data-fs-field
        class="border-ink/15 focus:border-saffron w-full rounded-xl border bg-white px-4 py-3 text-sm transition-colors outline-none"
      />
      <span data-fs-error="email" class="text-brick mt-1 block text-xs"></span>
    </div>

    <div class="sm:col-span-2">
      <label for="subject" class="text-ink mb-1.5 block text-sm font-medium">Subject</label>
      <select
        id="subject"
        name="subject"
        data-fs-field
        class="border-ink/15 focus:border-saffron w-full rounded-xl border bg-white px-4 py-3 text-sm transition-colors outline-none"
      >
        {subjects.map((s) => <option value={s}>{s}</option>)}
      </select>
    </div>

    <div class="sm:col-span-2">
      <label for="message" class="text-ink mb-1.5 block text-sm font-medium">Message</label>
      <textarea
        id="message"
        name="message"
        rows="5"
        required
        data-fs-field
        class="border-ink/15 focus:border-saffron w-full resize-none rounded-xl border bg-white px-4 py-3 text-sm transition-colors outline-none"
      ></textarea>
      <span data-fs-error="message" class="text-brick mt-1 block text-xs"></span>
    </div>

    {/* Formspree's own honeypot convention — silently discarded server-side if filled */}
    <input
      type="text"
      name="_gotcha"
      tabindex="-1"
      autocomplete="off"
      class="pointer-events-none absolute h-0 w-0 opacity-0"
      aria-hidden="true"
    />

    <div class="sm:col-span-2">
      <button
        type="submit"
        data-fs-submit-btn
        class="bg-saffron hover:bg-saffron-dark inline-flex items-center justify-center gap-2 rounded-full px-7 py-3.5 text-sm font-semibold text-white transition-all duration-300 hover:-translate-y-0.5 disabled:opacity-60 disabled:hover:translate-y-0"
      >
        Send message
        <Icon name="arrow-right" class="h-4 w-4" />
      </button>
    </div>
  </form>
</div>

<script>
  // Imported from the explicit ESM entry point: this package's "browser"
  // field (which bundlers prefer for client-side <script> code) points to
  // an IIFE build meant for a <script src> tag, not `import {}` — it has no
  // named exports, so the bare specifier resolves to the wrong build.
  import { initForm } from '@formspree/ajax/dist/index.mjs';

  function initContactForms(): void {
    document.querySelectorAll<HTMLElement>('[data-contact-form]').forEach((wrapper) => {
      if (wrapper.dataset.bound === 'true') return;
      const formId = wrapper.dataset.formId;
      const formEl = wrapper.querySelector<HTMLFormElement>('#contact-form');
      if (!formId || !formEl) return;

      wrapper.dataset.bound = 'true';
      initForm({ formElement: formEl, formId });
    });
  }

  document.addEventListener('astro:page-load', initContactForms);
</script>
