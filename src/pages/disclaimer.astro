---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import PortableText from '../components/PortableText.astro';
import { getPageBySlug, getSiteSettings } from '../lib/sanity/queries';

const [page, settings] = await Promise.all([getPageBySlug('disclaimer'), getSiteSettings()]);
const orgLabel = settings.legalName || settings.orgName;
---

<BaseLayout
  title={page?.seo?.metaTitle || page?.title || 'Disclaimer'}
  description={page?.seo?.metaDescription}
>
  <PageHeader eyebrow="Legal" heading={page?.title ?? 'Disclaimer'} />
  <section class="bg-white pb-24 sm:pb-32">
    <Container size="narrow">
      {
        page?.body && page.body.length > 0 ? (
          <PortableText value={page.body} />
        ) : (
          <div class="text-muted space-y-5 leading-relaxed">
            <p class="border-marigold/30 bg-marigold/10 text-ink/80 rounded-xl border p-4 text-sm">
              Placeholder content — replace with your real disclaimer in Sanity Studio (create a
              "Simple Page" with the slug{' '}
              <code class="bg-ink/5 rounded px-1.5 py-0.5 font-mono text-xs">disclaimer</code>).
              We'd recommend having this reviewed by legal counsel for your jurisdiction.
            </p>
            <p>
              The content on this website is provided by {orgLabel} for general informational
              purposes. While we work to keep impact figures and programme details accurate and
              current, we make no guarantee that every page is complete or up to date at any given
              moment.
            </p>
            <p>
              Links to third-party websites are provided for convenience; we aren't responsible for
              their content or practices.
            </p>
          </div>
        )
      }
    </Container>
  </section>
</BaseLayout>
