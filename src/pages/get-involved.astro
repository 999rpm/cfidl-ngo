---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import { getGetInvolvedPage } from '../lib/sanity/queries';

const page = await getGetInvolvedPage();
---

<BaseLayout title={page.seo?.metaTitle || 'Get Involved'} description={page.seo?.metaDescription}>
  <PageHeader eyebrow={page.eyebrow} heading={page.heading} body={page.intro} />

  <section class="bg-white py-20 sm:py-24">
    <Container>
      <div data-animate-group class="grid gap-6 lg:grid-cols-3">
        {
          (page.ways ?? []).map((way) => (
            <div
              data-animate-item
              class="border-ink/[0.06] bg-mist flex flex-col rounded-2xl border p-8"
            >
              <div class="bg-saffron/10 text-saffron flex h-11 w-11 items-center justify-center rounded-full">
                <Icon name={way.icon ?? 'community'} class="h-5 w-5" />
              </div>
              <h3 class="font-display text-ink mt-5 text-xl font-semibold">{way.title}</h3>
              <p class="text-muted mt-3 flex-1 text-sm leading-relaxed">{way.description}</p>
              {way.cta && (
                <Button
                  href={way.cta.href}
                  variant={way.cta.style || 'secondary'}
                  class="mt-6 w-fit"
                >
                  {way.cta.label}
                </Button>
              )}
            </div>
          ))
        }
      </div>
    </Container>
  </section>
</BaseLayout>
