# ─────────────────────────────────────────────────────────────────────────
# Copy this file to .env for local development. In production, set these as
# environment variables in your host's dashboard (Vercel/Netlify project
# settings) — never commit a real .env file.
#
# Variables prefixed PUBLIC_ are exposed to client-side JS by Astro/Vite.
# Anything WITHOUT that prefix stays server-only (safe for secrets/passwords).
# ─────────────────────────────────────────────────────────────────────────

# Used to generate absolute URLs in the sitemap, RSS feed and SEO tags.
PUBLIC_SITE_URL=https://www.cfidl.org

# ── Sanity (CMS) ────────────────────────────────────────────────────────
# Create a free project at https://www.sanity.io/get-started
# Project ID + dataset are shown in manage.sanity.io -> Project settings.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2026-01-01
# Only needed if you flip the dataset to private, or want to read drafts.
# Create one under manage.sanity.io -> API -> Tokens ("Viewer" is enough).
SANITY_API_READ_TOKEN=

# ── Formspree (contact form) ────────────────────────────────────────────
# Create a form at https://formspree.io -> copy the ID from the endpoint
# it gives you: https://formspree.io/f/XXXXXXXX  (the XXXXXXXX part).
PUBLIC_FORMSPREE_FORM_ID=

# ── Zoho Mail (SMTP for the newsletter sign-up confirmation) ────────────
# Standard settings: smtp.zoho.com, port 465 (SSL) or 587 (STARTTLS).
# If your Zoho account is on the EU data centre use smtp.zoho.eu, on the
# India data centre use smtp.zoho.in. Paid Workspace plans sometimes use
# smtppro.zoho.com instead — check Zoho Mail > Settings > Mail Accounts.
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_SECURE=true
# Full mailbox address, e.g. hello@cfidl.org
ZOHO_SMTP_USER=
# Your Zoho account password, or an app-specific password if 2FA is on
# (accounts.zoho.com > Security > App Passwords).
ZOHO_SMTP_PASSWORD=
# Internal address that gets pinged whenever someone subscribes.
# Defaults to ZOHO_SMTP_USER if left blank.
ZOHO_NOTIFY_TO=
# Friendly "From" name on outgoing mail.
NEWSLETTER_FROM_NAME=CFIDL
